# Proxy reverso do mapa (gerado por deploy/instalar_vps.sh; __DOMINIO__ é substituído pelo domínio).
# O Caddy emite e renova o certificado HTTPS automaticamente (Let's Encrypt).
__DOMINIO__ {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
		Permissions-Policy "geolocation=(), camera=(), microphone=()"
		-Server
	}

	# A API só escuta em 127.0.0.1:8010 (não fica exposta diretamente na internet)
	reverse_proxy 127.0.0.1:8010

	log {
		output file /var/log/caddy/eleicoes.log {
			roll_size 50MiB
			roll_keep 5
		}
	}
}
