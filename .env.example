# Copie para .env e troque os valores. Nunca versione o .env.
POSTGRES_DB=tse
POSTGRES_USER=tse_admin
POSTGRES_PASSWORD=troque-esta-senha
# Senha do usuário somente leitura usado pela API
TSE_LEITURA_PASSWORD=troque-esta-senha-tambem

# Portas locais (publicadas apenas em 127.0.0.1)
DB_PORT=5435
API_PORT=8010

# Opcional: se definido, a API exige o header X-API-Key com este valor
API_TOKEN=
API_STATEMENT_TIMEOUT_MS=20000
API_POOL_MAX=10

# Carga padrão: UFs, BR (Presidente) e/ou ZZ separados por vírgula, ou ALL
ETL_ANO=2026
ETL_ARQUIVOS=AC,BR

# Ajuste conforme a memória da VPS (ex.: 25% da RAM para shared_buffers)
PG_SHARED_BUFFERS=256MB
PG_WORK_MEM=32MB
PG_MAINTENANCE_WORK_MEM=512MB
PG_MAX_WAL_SIZE=4GB
